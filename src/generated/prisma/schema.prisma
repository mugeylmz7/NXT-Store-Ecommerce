// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  priceCents      Int // smallest currency unit: 1999 = 19.99 in the given currency
  currency        Currency @default(EUR)
  category        Category
  stock           Int      @default(0)
  imageUrls       String[] // URLs returned by Vercel Blob
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stripeProductId String? // Stripe için yeni eklenen alanlar (isteğe bağlı/optional yapıyoruz ki mevcut veriler patlamasın)
  stripePriceId   String?

  orderItems OrderItem[]

  @@map("products")
}

// Yeni ekleyeceğimiz User modeli (Profil bilgilerini tutmak için):
model User {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  auth0Id     String   @unique // Auth0'dan gelen benzersiz kullanıcı ID'si
  email       String   @unique
  name        String?
  address     String?
  city        String?
  postalCode  String?
  country     String?
  phone       String?
  role        String   @default("USER") // USER veya ADMIN
  isSuspended Boolean  @default(false) // Askıya alınma durumu
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]
}

model Order {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  stripeSessionId String?     @unique
  userId          String?     @db.ObjectId
  user            User?       @relation(fields: [userId], references: [id])
  userEmail       String? // Email gönderme
  status          OrderStatus @default(PENDING)
  cancelledBy     String? // "USER" veya "ADMIN" (İptal edeni takip etmek için)
  shippedAt       DateTime? // Kargoya verilme tarihi
  cancelledAt     DateTime? // İptal edilme tarihi
  totalCents      Int
  currency        Currency    @default(EUR)
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String  @db.ObjectId
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String  @db.ObjectId
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  priceCents Int

  @@map("order_items")
}

model SupportTicket {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String?
  subject   String
  message   String
  status    String   @default("OPEN") // "OPEN" veya "RESOLVED"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("support_tickets")
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String // Bildirimin gideceği kullanıcının ID/Email'i veya Adminler için "ADMIN"
  title     String
  message   String
  link      String // Tıklayınca gidilecek yol (/admin/users, /admin/tickets, /user/orders vs.)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

enum OrderStatus {
  PENDING // Sipariş Alındı / Beklemede
  PAID // Ödendi / Hazırlanıyor
  SHIPPED // Kargoda
  CANCELLED // İptal Edildi
  DELIVERED // Teslim Edildi
}

enum Currency {
  EUR
  GBP
  TRY
  USD
}

enum Category {
  ELECTRONICS
  CLOTHING
  HOME
  SPORTS
  OTHER
}
