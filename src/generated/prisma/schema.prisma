// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String
  priceCents      Int // smallest currency unit: 1999 = 19.99 in the given currency
  currency        Currency @default(EUR)
  category        Category
  stock           Int      @default(0)
  imageUrls       String[] // URLs returned by Vercel Blob
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  stripeProductId String? // Stripe için yeni eklenen alanlar (isteğe bağlı/optional yapıyoruz ki mevcut veriler patlamasın)
  stripePriceId   String?

  @@map("products")
}

// Yeni ekleyeceğimiz User modeli (Profil bilgilerini tutmak için):
model User {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  auth0Id    String   @unique // Auth0'dan gelen benzersiz kullanıcı ID'si
  email      String   @unique
  name       String?
  address    String?
  city       String?
  postalCode String?
  country    String?
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Currency {
  EUR
  GBP
  TRY
  USD
}

enum Category {
  ELECTRONICS
  CLOTHING
  HOME
  SPORTS
  OTHER
}
